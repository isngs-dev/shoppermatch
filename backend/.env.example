# ---------------------------------------------------------------------------
# ShopperMatch.AI backend configuration. Copy to `.env` and adjust as needed.
# The demo runs with these defaults out of the box (SQLite + mock email).
# ---------------------------------------------------------------------------

# General
APP_NAME=ShopperMatch.AI
ENVIRONMENT=development

# Secret used to sign access tokens — CHANGE THIS in production.
SECRET_KEY=dev-insecure-secret-change-me-in-production

# ---- Database ----
# SQLite (zero-dependency local default):
DATABASE_URL=sqlite+aiosqlite:///./shoppermatch.db
# PostgreSQL (recommended / docker):
# DATABASE_URL=postgresql+asyncpg://shoppermatch:shoppermatch@localhost:5432/shoppermatch

# ---- Public URL ----
# Origin the app is reachable at; used to build tracking/pixel/shopper URLs
# that are embedded in emails.
PUBLIC_BASE_URL=http://localhost:8000

# ---- CORS ----
# Comma-separated origins, or * for all (demo default).
CORS_ORIGINS=*

# ---- Email ----
# mock = never sends, returns a preview (default). sendgrid = real delivery.
# EMAIL_FROM_NAME / EMAIL_FROM_ADDRESS double as "SENDGRID_FROM_NAME" /
# "SENDGRID_FROM_EMAIL" for every provider services/email.py supports.
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
EMAIL_FROM_NAME=ISN Shopper Recruitment
EMAIL_FROM_ADDRESS=recruitment@isn-demo.example

# Optional: verifies POST /api/webhooks/sendgrid signatures (SendGrid ->
# Settings -> Mail Settings -> Event Webhook -> Signed Event Webhook
# Requests -> Verification Key). Blank = webhook accepts unverified calls.
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# ---- Demo admin login ----
DEMO_ADMIN_NAME=ISN Admin
DEMO_ADMIN_EMAIL=admin@isn.com
DEMO_ADMIN_PASSWORD=isn-demo-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Static frontend ----
# Directory containing the built SPA (index.html). Leave as-is for docker.
STATIC_DIR=static

# ---- Seeding ----
AUTO_SEED=true

# ---- Rate limiting (tracking endpoints, requests per minute per client) ----
TRACKING_RATE_LIMIT_PER_MINUTE=240
