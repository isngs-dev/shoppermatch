# ---------------------------------------------------------------------------
# Root-level overrides for docker-compose. Copy to `.env` to customise.
# Everything has a sensible default — the demo runs with no .env at all.
# ---------------------------------------------------------------------------

# Ports published on the host
APP_PORT=8000
DB_PORT=5432

# Public origin the app is reachable at (used to build tracking/pixel/shopper
# URLs embedded in emails). Change this when deploying behind a real domain.
PUBLIC_BASE_URL=http://localhost:8000

# Optional: after recording an invitation CTA click, redirect the shopper here.
# Leave blank to use the built-in ShopperMatch shopper page.
INVITATION_DESTINATION_URL=

# CHANGE in production — signs access tokens.
SECRET_KEY=change-me-in-production

ENVIRONMENT=production
AUTO_SEED=true

# Email: mock (default, no external calls), sendgrid (requires key), or smtp.
# EMAIL_FROM_NAME / EMAIL_FROM_ADDRESS double as "SENDGRID_FROM_NAME" /
# "SENDGRID_FROM_EMAIL" — kept as one setting rather than duplicating it per
# provider, since every provider in services/email.py reads the same From.
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
EMAIL_FROM_NAME=ISN Shopper Recruitment
EMAIL_FROM_ADDRESS=recruitment@isn-demo.example

# Optional: verifies POST /api/webhooks/sendgrid request signatures.
# From SendGrid: Settings -> Mail Settings -> Event Webhook -> Signed Event
# Webhook Requests -> Verification Key. Leave blank to accept unverified
# webhook calls (fine behind a private ngrok tunnel, not for production).
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Gmail SMTP: create a Google App Password. EMAIL_FROM_ADDRESS and SMTP_USERNAME
# must be exactly the same Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ShopperMatch-owned outbox worker: queued messages are attempted in the
# background and retried on provider errors.
EMAIL_WORKER_POLL_SECONDS=3
EMAIL_MAX_ATTEMPTS=3

CORS_ORIGINS=*

# Demo admin login
DEMO_ADMIN_EMAIL=admin@isn.com
DEMO_ADMIN_PASSWORD=isn-demo-2026
